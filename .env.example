# ---- Copia este archivo a .env.local para probar en tu ordenador ----
# En Vercel, estas mismas variables van en Settings → Environment Variables.

# PayPal (developer.paypal.com → Apps & Credentials). Empieza con las de
# Sandbox; cuando todo funcione, cambia a las Live y pon PAYPAL_ENV=live.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Precio y moneda (por defecto 4.99 USD). EUR también vale.
GANATELO_PRECIO=4.99
GANATELO_MONEDA=USD

# Vercel Blob: se crea en Storage → Create → Blob y Vercel añade el token solo.
# En local no hace falta: los regalos se guardan en .data/
# BLOB_READ_WRITE_TOKEN=

# Email al comprador con su enlace (opcional; resend.com, dominio verificado)
# RESEND_API_KEY=
# RESEND_FROM=hola@tudominio.com

# Tu email: recibe el aviso de cada venta y aparece en la página legal
# CONTACTO_EMAIL=

# Contraseña del panel /api/pedidos (pon algo largo y aleatorio)
# ADMIN_TOKEN=

# URL pública (si no, se deduce del dominio por el que entran)
# GANATELO_URL=https://ganatelo.app
